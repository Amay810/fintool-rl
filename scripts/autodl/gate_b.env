# AutoDL Gate B paths. Source from GPU jobs only after CPU checks pass.
# Do not point hydra/logs/weights at /.

FINTOOL_DATA_ROOT=/root/autodl-tmp
FINTOOL_REPO=/root/autodl-tmp/fintool-rl
FINTOOL_MODEL_DIR=/root/autodl-tmp/models/Qwen3-4B-Instruct-2507
FINTOOL_RUN_DIR=/root/autodl-tmp/runs/gate_b
HF_HOME=/root/autodl-tmp/hf-home
MODELSCOPE_CACHE=/root/autodl-tmp/modelscope-cache
TRANSFORMERS_CACHE=/root/autodl-tmp/hf-home
FINTOOL_LLM_BASE_URL=http://127.0.0.1:8000/v1
FINTOOL_LLM_MODEL=Qwen3-4B-Instruct-2507
FINTOOL_LLM_API_KEY=
FINTOOL_LLM_TEMPERATURE=0.7
FINTOOL_GATE_B_K=4
FINTOOL_GATE_B_SPLIT=dev
FINTOOL_GATE_B_LIMIT=20
