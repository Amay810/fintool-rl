#!/bin/bash
#PBS -N fintool-env
#PBS -q normal
#PBS -P personal
#PBS -l select=1:ncpus=16:ngpus=1:mem=64gb
#PBS -l walltime=03:00:00
#PBS -j oe

# Creates the dedicated FinTool environment on a compute node. The login node
# should only submit this file and inspect the resulting small text logs.

set -euo pipefail

PROJECT=/scratch/users/ntu/s250045/fintool-rl
ENV=/scratch/users/ntu/s250045/conda-envs/fintool-vllm0102
CONDA_CACHE=/scratch/users/ntu/s250045/conda-pkgs/fintool-vllm0102
PIP_CACHE=/scratch/users/ntu/s250045/pip-cache/fintool-vllm0102

cd "$PROJECT"
module load miniforge3/25.3.1
source "$(conda info --base)/etc/profile.d/conda.sh"

export CONDA_PKGS_DIRS="$CONDA_CACHE"
export PIP_CACHE_DIR="$PIP_CACHE"
export UV_CACHE_DIR=/scratch/users/ntu/s250045/uv-cache/fintool-vllm0102
export HF_HOME=/scratch/users/ntu/s250045/hf-cache
export PYTHONNOUSERSITE=1

mkdir -p "$CONDA_CACHE" "$PIP_CACHE" "$UV_CACHE_DIR" "$HF_HOME" "$(dirname "$ENV")" logs

nvidia-smi
nvidia-smi --query-gpu=name,driver_version --format=csv,noheader

if [ ! -x "$ENV/bin/python" ]; then
  conda create --prefix "$ENV" python=3.11 pip -y
fi

conda activate "$ENV"
python -m pip install --upgrade pip setuptools wheel
python -m pip install "uv<0.9"

uv pip install \
  --python "$ENV/bin/python" \
  "vllm==0.10.2" \
  --extra-index-url https://wheels.vllm.ai/0.10.2/ \
  --torch-backend=cu128

python -m pip install -e "$PROJECT" --no-deps
python -m pip install "pytest>=8,<9"

which python
which vllm
which fintool-rl

python - <<'PY'
import torch
import vllm

print("torch:", torch.__version__)
print("torch CUDA build:", torch.version.cuda)
print("vLLM:", vllm.__version__)
print("CUDA available:", torch.cuda.is_available())
if not torch.cuda.is_available():
    raise SystemExit("PyTorch cannot access the allocated GPU")
print("GPU count:", torch.cuda.device_count())
print("GPU 0:", torch.cuda.get_device_name(0))
assert vllm.__version__ == "0.10.2"
PY

vllm serve --help | grep -E \
  'data-parallel-size|tensor-parallel-size|enable-auto-tool-choice|tool-call-parser|max-model-len'

fintool-rl --help >/dev/null
python -m pytest -q
conda list --explicit > logs/fintool-vllm0102.conda-explicit.txt
python -m pip freeze > logs/fintool-vllm0102.pip-freeze.txt

echo "ENVIRONMENT_READY=$ENV"
